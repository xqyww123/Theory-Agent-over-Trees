# lib/tat.jar is committed, and no_build keeps every `isabelle` invocation
# from rebuilding it on the user's machine; after a change to tat.scala the
# jar is rebuilt as docs/MODULE_STRUCTURE.md §5 says.
title = Isabelle/Scala/TAT
module = lib/tat.jar
no_build = true
requirements = \
  env:ISABELLE_SCALA_JAR
sources = \
  src/scala/tat.scala
services = \
  isabelle.tat.TAT_Tools \
  isabelle.tat.TAT_Functions
